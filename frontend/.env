# Optional API base URL. Leave empty to use the same origin (recommended for
# the all-in-one Docker image): in development the Vite proxy forwards /api to
# the backend, and in production the Go server serves both the app and the API.
# Set this to the backend origin when the UI is hosted separately, e.g. on
# GitHub Pages: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Optional sub-path the built app is served from. Defaults to "/". GitHub
# project pages live under /<repo>/, so the Pages deploy sets this for you.
# VITE_BASE_PATH=/simple-file-share/
VITE_BASE_PATH=
